    "src/gameMode.js",
    "src/questColors.js",

    "src/mapBanners.js",
    "src/questImportRoutes.js",
    "src/welcome.js",
    "src/strokeBounds.js",
    "src/roomViewModel.js",

    "src/objectivePinLayout.js",
    "src/questDiagnostic.js",
    "src/questVisibility.js",
    "src/operationalTasks.js",
    "src/squadFocus.js",

    "src/cameraMode.js",
    "src/chunkLoadRecovery.js"
  ]
}
