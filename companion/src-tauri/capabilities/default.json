{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default companion window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*.supabase.co/*" },
        { "url": "https://accounts.google.com/*" }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
